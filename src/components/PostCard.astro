---
const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}yazilar/${post.slug}/`;
const imageSrc = `${base}${post.image.replace(/^\//,'')}`;
---
<article class={`post-card ${post.theme}`}>
  <a class="post-visual" href={href} aria-label={post.title}>
    <img src={imageSrc} alt={post.imageAlt} loading="lazy" />
    <span class="post-chip">{post.category}</span>
  </a>
  <div class="post-body">
    <h3><a href={href}>{post.title}</a></h3>
    <p class="excerpt">{post.excerpt}</p>
    <p class="authors">{post.authors}</p>
    <p class="meta">{post.date} · {post.read} okuma</p>
  </div>
</article>
