---
const {post}=Astro.props; const base=import.meta.env.BASE_URL;
---
<article class={`post-card ${post.theme}`}><a class="post-visual" href={`${base}yazilar/${post.slug}/`} aria-label={post.title}><span>{post.category}</span></a><div class="post-body"><p class="category">{post.category}</p><h3><a href={`${base}yazilar/${post.slug}/`}>{post.title}</a></h3><p class="excerpt">{post.excerpt}</p><p class="authors">{post.authors}</p><p class="meta">{post.date} · {post.read} okuma</p></div></article>